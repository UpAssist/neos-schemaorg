prototype(UpAssist.Neos.SchemaOrg:Component.Organization) < prototype(Neos.Fusion:Component) {
    @if.hasOrganizationMixin = ${q(site).is('[instanceof UpAssist.Neos.SchemaOrg:Mixin.Organization]')}
    @if.isLive = ${!renderingMode.isEdit}

    # Own cache entry per site: the page entry is not tagged with the site node,
    # so a change to a site property would otherwise only show on pages whose
    # own content changed.
    @cache {
        mode = 'cached'
        entryIdentifier {
            site = ${Neos.Caching.entryIdentifierForNode(site)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(site)}
        }
    }

    name = ${q(site).property('schemaOrgName') || q(site).property('title')}
    description = ${q(site).property('schemaOrgDescription')}
    url = UpAssist.Neos.SchemaOrg:Helper.SiteUrl
    logo = ${q(site).property('schemaOrgLogo')}
    phone = ${q(site).property('schemaOrgPhone')}
    email = ${q(site).property('schemaOrgEmail')}
    sameAs = ${q(site).property('schemaOrgSameAs')}

    @private {
        logoUrl = Neos.Fusion:ResourceUri {
            resource = ${props.logo.resource}
            absolute = true
            @if.hasLogo = ${props.logo && props.logo.resource}
        }
    }

    renderer = afx`
        <script type="application/ld+json">
{Json.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': props.name,
    'description': props.description,
    'url': props.url,
    'logo': private.logoUrl,
    'telephone': props.phone,
    'email': props.email,
    'sameAs': props.sameAs ? String.split(String.trim(props.sameAs), String.chr(10)) : null
})}
        </script>
    `
}
